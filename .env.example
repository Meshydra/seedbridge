# Copy to .env and fill in. Without NEBIUS_API_KEY the app runs in demo mode (simulated model answers).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Long random string; signs the login cookie.
SEEDBRIDGE_SECRET=change-me

# Force demo mode even with a key set:
# SEEDBRIDGE_DEMO=1

# Override the model used for any step (defaults shown):
# MODEL_INTAKE=nvidia/Nemotron-3_5-Lightning
# MODEL_GAPS=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# MODEL_MATCH=nvidia/nemotron-3-super-120b-a12b
# MODEL_REVIEW=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_DRAFT=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# If a model is served from a different regional endpoint, set a per-step base URL:
# BASE_URL_REVIEW=https://...
